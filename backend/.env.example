# Copy to backend/.env for local development. NEVER commit real values.
# In production, set these in Vercel → Project → Settings → Environment Variables.

ZENTY_ENV=development                 # set to "production" on Vercel
APP_URL=http://localhost:5173         # e.g. https://zenty.vercel.app in production

# Postgres from Neon / Supabase (leave unset locally to use a SQLite file)
# DATABASE_URL=postgresql://user:pass@ep-xxxx-pooler.us-east-2.aws.neon.tech/zenty?sslmode=require

# Encrypts bank access tokens. Generate once and keep it secret:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ZENTY_ENCRYPTION_KEY=

# Google sign-in: Google Cloud Console → APIs & Services → Credentials → OAuth client ID (Web)
GOOGLE_CLIENT_ID=

# Emails: https://resend.com → API Keys
RESEND_API_KEY=
EMAIL_FROM=Zenty <onboarding@resend.dev>

# Bank linking: https://dashboard.plaid.com → Developers → Keys
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox

# SMS codes for two-step sign-in: https://console.twilio.com → Account Info
# (a free trial can only text phone numbers you've verified in Twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Sessions: sign out after this many idle minutes, and after this many hours at most.
SESSION_IDLE_MINUTES=15
SESSION_MAX_HOURS=12

# Random string; Vercel Cron sends it to the scheduled-job endpoints
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
CRON_SECRET=
